ANTHROPIC_API_KEY=sk-ant-...

# Multi-user login. The first signup whose email matches
# FLAVORPRESS_ADMIN_EMAIL becomes the admin and can issue invites via the
# `npm run auth:invite` CLI. The session HMAC key must be at least
# 32 bytes. In development, a placeholder is used when unset.
# FLAVORPRESS_ADMIN_EMAIL=you@example.com
# FLAVORPRESS_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Local mode (macOS app, single-user dev). When set to "local", the auth
# surface skips signup/login entirely and pins every request to a bootstrap
# admin user with id "default-user". Any pre-existing single-user data on
# disk is picked up automatically. The macOS launcher sets this for you.
# FLAVORPRESS_AUTH=local
# FLAVORPRESS_LOCAL_EMAIL=local@flavorpress.app
# Public app origin. Required in production so callbacks and CSRF checks do
# not trust arbitrary Host headers.
# FLAVORPRESS_ORIGIN=https://your-flavorpress.example.com
# Optional comma-separated list for trusted reverse proxy origins.
# FLAVORPRESS_ALLOWED_ORIGINS=https://your-flavorpress.example.com

# Vercel Cron secret for /api/cron/poll. Set this in production so source
# polling runs from Vercel Cron without exposing a public mutation route.
# CRON_SECRET=replace-with-random-string

# Required in production before storing WordPress Application Passwords or
# sensitive /settings values in the database.
# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# FLAVORPRESS_ENCRYPTION_KEY=...

# Local + macOS app: ride your existing Claude Code login instead of an API key.
# - Auto-detected when no ANTHROPIC_API_KEY is set and `claude` is on PATH.
# - Set FLAVORPRESS_LOCAL_CLAUDE=1 to force it on (overrides any API key).
# - Not supported on Vercel; the user's local Claude install is unreachable
#   from a serverless function, so this throws at cold start there.
# - Fact-check still requires an API key (it uses Anthropic's web_search
#   server tool, which Claude Code does not expose).
# FLAVORPRESS_LOCAL_CLAUDE=1

# Local dev: leave LIBSQL_URL unset to use ./.data/flavorpress.db (sqlite file).
# Vercel + Turso: set both.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=...

# Webhook secret for /api/inbound (any random string; required to accept inbound posts).
# INBOUND_SECRET=change-me

# MCP token for /api/mcp tool calls. Leave unset to disable tools/call.
# Discovery still works without a token when no Authorization header is sent.
# FLAVORPRESS_MCP_TOKEN=change-me-too
