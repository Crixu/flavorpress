ANTHROPIC_API_KEY=sk-ant-...

# Local dev: leave LIBSQL_URL unset to use ./.data/flavorpress.db (sqlite file).
# Vercel + Turso: set both.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=...

# Webhook secret for /api/inbound (any random string; required to accept inbound posts).
INBOUND_SECRET=change-me
